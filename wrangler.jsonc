{
  "$schema": "https://unpkg.com/wrangler/config-schema.json",
  // Static site on Cloudflare Workers (static assets, no server code).
  // v2: Astro builds into ./dist (public/ is copied into it).
  // The name must match the Worker name in the Cloudflare dashboard.
  "name": "alpon-dev",
  "compatibility_date": "2026-09-29",
  "assets": {
    "directory": "./dist",
    "not_found_handling": "404-page",
    "html_handling": "auto-trailing-slash",
  },
  "routes": [
    {
      "pattern": "alpon.dev",
      "custom_domain": true,
    },
  ],
  "workers_dev": true,
  "preview_urls": true,
  "previews": {},
}
