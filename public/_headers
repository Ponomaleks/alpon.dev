/*
  X-Content-Type-Options: nosniff
  Referrer-Policy: strict-origin-when-cross-origin
  Permissions-Policy: camera=(), microphone=(), geolocation=(), interest-cohort=()
  Strict-Transport-Security: max-age=31536000; includeSubDomains
  X-Frame-Options: SAMEORIGIN
  Content-Security-Policy: default-src 'self'; script-src 'self' {{THEME_BOOTSTRAP_HASH}}; style-src 'self'; img-src 'self' data:; font-src 'self'; frame-src 'self'; object-src 'none'; base-uri 'self'; form-action 'none'; frame-ancestors 'self'

/
  Cache-Control: public, max-age=0, must-revalidate

/fonts/*
  Cache-Control: public, max-age=31536000, immutable
  Access-Control-Allow-Origin: *

/img/*
  Cache-Control: public, max-age=604800

/cv
  Cache-Control: public, max-age=0, must-revalidate

/cv/en
  Cache-Control: public, max-age=0, must-revalidate

/cv/no
  Cache-Control: public, max-age=0, must-revalidate

/cv/alexander-ponomarenko-cv-en.pdf
  Cache-Control: public, max-age=3600, must-revalidate
  Content-Disposition: inline; filename="Alexander_Ponomarenko_CV_EN.pdf"

/cv/alexander-ponomarenko-cv-no.pdf
  Cache-Control: public, max-age=3600, must-revalidate
  Content-Disposition: inline; filename="Alexander_Ponomarenko_CV_NO.pdf"

/cv/cv-en-1.webp
  Cache-Control: public, max-age=3600, must-revalidate

/cv/cv-en-2.webp
  Cache-Control: public, max-age=3600, must-revalidate

/cv/cv-no-1.webp
  Cache-Control: public, max-age=3600, must-revalidate

/cv/cv-no-2.webp
  Cache-Control: public, max-age=3600, must-revalidate

/alexander-ponomarenko.vcf
  Content-Type: text/vcard; charset=utf-8
  Content-Disposition: attachment; filename="Alexander Ponomarenko.vcf"
