{
  "$comment": "The agreed Content-Security-Policy (fjord-foundation ADR-0002, test plan AC-12 contract row). An intentional policy change updates this file in the same PR. {{hash}} is the theme bootstrap sha256.",
  "rule": "/*",
  "directives": {
    "default-src": ["'self'"],
    "script-src": ["'self'", "{{hash}}", "https://static.cloudflareinsights.com/beacon.min.js"],
    "connect-src": ["'self'", "https://cloudflareinsights.com"],
    "style-src": ["'self'"],
    "img-src": ["'self'", "data:"],
    "font-src": ["'self'"],
    "frame-src": ["'self'"],
    "object-src": ["'none'"],
    "base-uri": ["'self'"],
    "form-action": ["'none'"],
    "frame-ancestors": ["'self'"]
  }
}
