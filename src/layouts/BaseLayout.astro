---
// The shared layout and its head contract (fjord-foundation sad §8): charset → viewport →
// theme bootstrap → two font preloads → stylesheets (tokens → fonts → base) → title,
// description, robots, icons. A page passes only a title and a description (AC-13).
import stylesheet from '../styles/global.css?url';
import themeBootstrapSource from '../scripts/theme-bootstrap.js?raw';
import { normaliseNewlines } from '../scripts/newlines.ts';
import { contact } from '../data/contact';
import SkipLink from '../components/layout/SkipLink.astro';
import Header from '../components/layout/Header.astro';
import MobileMenu from '../components/layout/MobileMenu.astro';
import CtaBand from '../components/layout/CtaBand.astro';
import Footer from '../components/layout/Footer.astro';
import MobileBar from '../components/layout/MobileBar.astro';
import Toast from '../components/ui/Toast.astro';

interface Props {
  title: string;
  description: string;
  lang?: 'en' | 'no';
  noindex?: boolean;
  // Page options (base-components sad §5): every one is optional and has a default.
  current?: 'cv' | 'contact';
  headerVariant?: 'default' | 'on-spruce';
  headerCta?: 'auto' | 'secondary';
  mobileBar?: boolean;
  ctaBand?: boolean;
  cvLang?: 'en' | 'no';
}

const {
  title,
  description,
  lang = 'en',
  noindex = false,
  current,
  headerVariant = 'default',
  headerCta = 'auto',
  mobileBar = true,
  ctaBand = true,
  cvLang = 'en',
} = Astro.props;
// The same LF text the CSP integration hashes (ADR-0002).
const themeBootstrap = normaliseNewlines(themeBootstrapSource);
---

<!doctype html>
<html lang={lang}>
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <script is:inline set:html={themeBootstrap} />
    <link
      rel="preload"
      href="/fonts/schibsted-grotesk-400.woff2"
      as="font"
      type="font/woff2"
      crossorigin
    />
    <link
      rel="preload"
      href="/fonts/schibsted-grotesk-600.woff2"
      as="font"
      type="font/woff2"
      crossorigin
    />
    <link rel="stylesheet" href={stylesheet} />
    <title>{title}</title>
    <meta name="description" content={description} />
    {noindex && <meta name="robots" content="noindex" />}
    <link rel="icon" href="/favicon.svg" type="image/svg+xml" />
    <link rel="apple-touch-icon" href="/apple-touch-icon.png" />
  </head>
  <body>
    <SkipLink />
    <Header
      current={current}
      variant={headerVariant === 'on-spruce' ? 'on-spruce' : undefined}
      cta={headerCta}
    />
    <MobileMenu current={current} />
    <main id="main" tabindex="-1">
      <slot />
    </main>
    {ctaBand && <CtaBand cvLang={cvLang} />}
    <Footer />
    {mobileBar && <MobileBar cvHref={contact.links.cv} contactHref={contact.links.contact} />}
    <Toast />
  </body>
</html>
