---
// The shared layout and its head contract (fjord-foundation sad §8): charset → viewport →
// theme bootstrap → two font preloads → stylesheets (tokens → fonts → base) → title,
// description, robots, icons. A page passes only a title and a description (AC-13).
import stylesheet from '../styles/global.css?url';
import themeBootstrap from '../scripts/theme-bootstrap.js?raw';

interface Props {
  title: string;
  description: string;
  lang?: 'en' | 'nb';
  noindex?: boolean;
}

const { title, description, lang = 'en', noindex = false } = Astro.props;
---

<!doctype html>
<html lang={lang}>
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1, viewport-fit=cover" />
    <script is:inline set:html={themeBootstrap} />
    <link
      rel="preload"
      href="/fonts/schibsted-grotesk-400.woff2"
      as="font"
      type="font/woff2"
      crossorigin
    />
    <link
      rel="preload"
      href="/fonts/schibsted-grotesk-600.woff2"
      as="font"
      type="font/woff2"
      crossorigin
    />
    <link rel="stylesheet" href={stylesheet} />
    <title>{title}</title>
    <meta name="description" content={description} />
    {noindex && <meta name="robots" content="noindex" />}
    <link rel="icon" href="/favicon.svg" type="image/svg+xml" />
    <link rel="apple-touch-icon" href="/apple-touch-icon.png" />
  </head>
  <body>
    <slot />
  </body>
</html>
