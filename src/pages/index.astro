---
// SCR-01 home placeholder (fjord-foundation screens.md) until step 4: proves that a page with
// only a title and a description gets the whole Fjord base (AC-13).
import BaseLayout from '../layouts/BaseLayout.astro';
---

<BaseLayout
  title="Alexander Ponomarenko · Software Engineer"
  description="Alexander Ponomarenko, Software Engineer and Full Stack Developer based in Oslo, Norway."
>
  <div class="home" id="contact">
    <h1>Alexander Ponomarenko</h1>
    <p>
      Software Engineer · Full Stack Developer · <span lang="no">Oslo, Norge</span>
    </p>
  </div>
</BaseLayout>

<style>
  .home {
    max-width: var(--fjord-content-max);
    padding: var(--fjord-space-section) var(--fjord-grid-margin);
  }

  h1 {
    font-size: var(--fjord-text-h1);
  }

  p {
    margin: var(--fjord-space-3) 0 0;
    color: var(--fjord-color-text-muted);
    font-size: var(--fjord-text-lead);
  }
</style>
