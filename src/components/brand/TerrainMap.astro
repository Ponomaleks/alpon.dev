---

<div class="terrain" aria-hidden="true">
  <div class="terrain__frame">
    <svg
      class="terrain__map"
      viewBox="0 0 400 250"
      preserveAspectRatio="xMidYMid slice"
      aria-hidden="true"
      focusable="false"
    >
      <path
        data-part="relief"
        d={relief}
        fill="none"
        stroke="currentColor"
        stroke-width="1"
        stroke-linecap="round"
        vector-effect="non-scaling-stroke"
      ></path>
    </svg>
    <span class="terrain__grid" data-part="grid" data-grid="4x4"></span>
    <span class="terrain__coord">59.91° N · 10.75° E</span>
  </div>
  <svg
    class="terrain__trail"
    viewBox="0 0 200 120"
    preserveAspectRatio="none"
    aria-hidden="true"
    focusable="false"
  >
    <path
      data-part="route"
      d="M20 100 C 60 90, 70 50, 120 60 S 180 30, 200 10"
      fill="none"
      stroke="currentColor"
      stroke-width="1.5"
      stroke-dasharray="4 5"
      vector-effect="non-scaling-stroke"
    ></path>
  </svg>
  <span class="terrain__pin" data-part="pin">
    <Icon name="map-pin" />
    <span>You are here</span>
  </span>
</div>

<style>
  .terrain {
    position: relative;
    padding: var(--fjord-space-10) var(--fjord-space-18) 0 0;
  }
  .terrain__frame {
    position: relative;
    overflow: hidden;
    aspect-ratio: 4 / 3;
    border-radius: var(--fjord-radius-md);
    border: var(--fjord-border-width) solid var(--fjord-color-border);
    background-color: var(--fjord-color-bg-sunken);
    color: var(--fjord-color-contour-line);
  }
  .terrain__map {
    position: absolute;
    inset: 0;
    display: block;
    width: 100%;
    height: 100%;
  }
  .terrain__grid {
    position: absolute;
    inset: 0;
    background-image:
      linear-gradient(
        var(--fjord-color-border) var(--fjord-border-width),
        transparent var(--fjord-border-width)
      ),
      linear-gradient(
        90deg,
        var(--fjord-color-border) var(--fjord-border-width),
        transparent var(--fjord-border-width)
      );
    background-size: 25% 25%;
    opacity: var(--fjord-opacity-muted);
    pointer-events: none;
  }
  .terrain__coord {
    position: absolute;
    left: var(--fjord-space-3);
    bottom: var(--fjord-space-2);
    font-family: var(--fjord-font-mono);
    font-size: var(--fjord-text-mono-sm);
    font-weight: var(--fjord-weight-regular);
    line-height: var(--fjord-leading-none);
    color: var(--fjord-color-text-muted);
  }
  .terrain__trail {
    position: absolute;
    left: 30%;
    top: var(--fjord-space-2);
    width: calc(70% + var(--fjord-space-2));
    height: 60%;
    color: var(--fjord-color-border-strong);
    overflow: visible;
  }
  .terrain__pin {
    position: absolute;
    right: 0;
    top: 0;
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: var(--fjord-space-1-5);
    color: var(--fjord-color-link);
  }
  .terrain__pin :global(svg) {
    width: var(--fjord-space-6);
    height: var(--fjord-space-6);
  }
  .terrain__pin span {
    font-family: var(--fjord-font-mono);
    font-size: var(--fjord-text-mono-sm);
    font-weight: var(--fjord-weight-regular);
    line-height: var(--fjord-leading-none);
    color: var(--fjord-color-text);
    white-space: nowrap;
  }
</style>
