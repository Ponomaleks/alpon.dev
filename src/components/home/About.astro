---
// About section (AC-07): heading, introduction and the quick facts. One column below 1024, 7 / 5 from 1024.
import SectionHeader from '../ui/SectionHeader.astro';
import QuickFacts from './QuickFacts.astro';
import { intro, quickFacts } from '../../data/home';

interface Props {
  /** Section number in the eyebrow, e.g. "01". */
  index: string;
}

const { index } = Astro.props;
---

<section class="about" id="about" aria-label="About">
  <div class="about__wrap">
    <div class="about__text">
      <SectionHeader index={index} eyebrow="About" title="Frontend-focused, full stack." />
      <p class="about__intro">{intro}</p>
    </div>
    <QuickFacts items={quickFacts} />
  </div>
</section>

<style>
  .about {
    padding-top: var(--fjord-space-section);
  }
  .about__wrap {
    display: grid;
    grid-template-columns: minmax(0, 1fr);
    gap: var(--fjord-space-10) var(--fjord-grid-gutter);
    width: 100%;
    max-width: calc(var(--fjord-content-max) + 2 * var(--fjord-grid-margin));
    margin-inline: auto;
    padding-inline: var(--fjord-grid-margin);
  }
  .about__text {
    display: flex;
    flex-direction: column;
    gap: var(--fjord-space-5);
    min-width: 0;
  }
  .about__intro {
    max-width: calc(var(--fjord-measure-narrow) * 5 / 4);
    margin: 0;
    font-size: var(--fjord-text-lead);
    line-height: var(--fjord-leading-body);
    text-wrap: pretty;
  }
  @media (min-width: 1024px) {
    .about__wrap {
      grid-template-columns: minmax(0, 7fr) minmax(0, 5fr);
      column-gap: var(--fjord-space-16);
    }
  }
</style>
