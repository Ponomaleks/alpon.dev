---
// The CV page body (AC-01, AC-02, AC-04; screens SCR-05 / SCR-06; sad §4 item 2): the head, the
// original-PDF preview control, the sections the CV data has in order and the side column. The
// grid is 8 and 4 of 12 parts from 1024 (page design `.x-cvgrid`). The three page files wrap it in
// BaseLayout and pass the CV language. The page script (T20) is loaded below; the print styles are in the style block.
import { cvEn } from '../../data/cv/en';
import { cvNo } from '../../data/cv/no';
import type { CvLang } from '../../data/cv/types';
import CvAside from './CvAside.astro';
import CvHead from './CvHead.astro';
import CvJob from './CvJob.astro';
import CvProjects from './CvProjects.astro';
import CvSection from './CvSection.astro';
import DatedRows from './DatedRows.astro';
import LanguageList from './LanguageList.astro';
import OriginalPdfPreview from './OriginalPdfPreview.astro';
import PrintContactLine from './PrintContactLine.astro';
import SkillGroup from './SkillGroup.astro';

interface Props {
  lang: CvLang;
}

const { lang } = Astro.props;
const cv = lang === 'no' ? cvNo : cvEn;
// The role line is the design's `title`; the Norwegian wording follows the Norwegian CV's terms.
const role =
  lang === 'no'
    ? 'Frontend-utvikler · backend-erfaring'
    : 'Frontend Developer · Backend Experience';
const sections = cv.sections.map((s) => ({ id: s.id, heading: s.heading }));
const number = (i: number) => String(i + 1).padStart(2, '0');
---

<div class="cv-page wrap">
  <CvHead lang={lang} role={role} location={`${cv.location} · ${cv.permit}`} />
  <PrintContactLine />
  <div class="cv-page__preview">
    <OriginalPdfPreview lang={lang} />
  </div>
  <div class="cv-page__grid">
    <article class="cv-page__main">
      {cv.sections.map((s, i) => (
        <CvSection id={s.id} index={number(i)} heading={s.heading}>
          {s.id === 'community' && s.paragraphs ? (
            <ul class="cv-page__list">
              {s.paragraphs.map((p) => (
                <li>{p}</li>
              ))}
            </ul>
          ) : (
            s.paragraphs?.map((p) => <p class="cv-page__text">{p}</p>)
          )}
          {s.skillGroups && (
            <div class="cv-page__skills">
              {s.skillGroups.map((group) => (
                <SkillGroup group={group} />
              ))}
            </div>
          )}
          {s.languages && <LanguageList languages={s.languages} />}
          {s.jobs && (
            <div class="cv-page__jobs">
              {s.jobs.map((job, j) => (
                <CvJob
                  job={{
                    ...job,
                    appliedLabel: cv.labels.appliedTechnologies,
                    internalLabel: cv.labels.internalProjects,
                  }}
                  first={j === 0}
                />
              ))}
            </div>
          )}
          {s.projects && <CvProjects lang={lang} note={s.note} projects={s.projects} />}
          {s.rows && <DatedRows rows={s.rows} />}
        </CvSection>
      ))}
    </article>
    <CvAside lang={lang} sections={sections} />
  </div>
</div>

<script>
  import '../../scripts/cv/index';
</script>

<style>
  .wrap {
    width: 100%;
    max-width: calc(var(--fjord-content-max) + 2 * var(--fjord-grid-margin));
    margin: 0 auto;
    padding: 0 var(--fjord-grid-margin);
  }
  .cv-page__preview {
    margin-top: var(--fjord-space-5);
  }
  .cv-page__grid {
    display: grid;
    grid-template-columns: minmax(0, 1fr);
    gap: var(--fjord-space-12);
    /* As the page design's `.x-section--tight`: space above only; the closing band brings its own. */
    padding: var(--fjord-space-block) 0 0;
  }
  .cv-page__main {
    display: flex;
    flex-direction: column;
    gap: var(--fjord-space-14);
    min-width: 0;
  }
  .cv-page__skills {
    display: grid;
    grid-template-columns: minmax(0, 1fr);
    gap: var(--fjord-space-5) var(--fjord-grid-gutter);
  }
  .cv-page__jobs {
    display: flex;
    flex-direction: column;
    gap: var(--fjord-space-10);
  }
  /* Running text as the page design's Prose (`.fj-prose`): the reading measure and the body's
     line height. */
  .cv-page__text,
  .cv-page__list {
    max-width: var(--fjord-measure);
    margin: 0;
    line-height: var(--fjord-leading-body);
  }
  .cv-page__text {
    text-wrap: pretty;
  }
  /* The design's list indent (1.3em) and space between items (0.35em). */
  .cv-page__list {
    padding-left: calc(var(--fjord-text-body) * 1.3);
  }
  .cv-page__list li + li {
    margin-top: calc(var(--fjord-text-body) * 0.35);
  }
  .cv-page__list li::marker {
    color: var(--fjord-color-text-muted);
    font-family: var(--fjord-font-mono);
    font-size: calc(var(--fjord-text-body) * 0.85);
  }
  @media (min-width: 768px) {
    .cv-page__skills {
      grid-template-columns: repeat(2, minmax(0, 1fr));
    }
  }
  @media (min-width: 1024px) {
    .cv-page__grid {
      grid-template-columns: minmax(0, 8fr) minmax(0, 4fr);
      gap: var(--fjord-space-18);
    }
  }

  /* Print (AC-11, AC-12, sad �8 Print, ADR-0002): the document is the content alone. The Print block
     of tokens.css already gives every theme the Dag colours; here the Shell and the controls go,
     the contact line shows and entries keep together. No @page rule: the browser's margins apply. */
  @media print {
    :global(.skip-link),
    :global(body > header),
    :global(.menu),
    :global(dialog),
    :global(footer),
    :global(.fj-band),
    :global([data-shell-bar]),
    :global(.back-to-top),
    :global(.crumbs),
    :global([data-lang-switch]),
    .cv-page :global(.tools),
    .cv-page__preview,
    .cv-page :global(.cv-aside) {
      /* Shell parts set their own display in their own sheets: print wins over all of them. */
      display: none !important;
    }
    :global(html),
    :global(body) {
      background: var(--fjord-print-bg);
    }
    /* Nothing after the content: the Shell's reserve at the end of the page and the screen height
       of main would add an empty sheet. */
    :global(body)::after {
      display: none !important;
    }
    :global(main) {
      min-height: 0;
    }
    :global(body) {
      font-size: var(--fjord-text-body-sm);
    }
    /* Black on white all through: muted greys do not survive a printer. */
    .cv-page {
      --fjord-color-text-muted: var(--fjord-color-text);
      /* A sheet reads smaller than a screen: the size tokens step down for the document. */
      --fjord-text-h1: var(--fjord-text-h3);
      --fjord-text-h2: var(--fjord-text-h4);
      --fjord-text-body: var(--fjord-text-body-sm);
      --fjord-text-ui-lg: var(--fjord-text-ui-sm);
      --fjord-text-ui: var(--fjord-text-ui-sm);
      --fjord-leading-body: var(--fjord-leading-normal);
    }
    .cv-page :global(.cv-print-line) {
      display: block;
      margin-top: var(--fjord-space-3);
    }
    /* Plain blocks, not a grid and a flex column: Firefox does not break a grid item across sheets,
       so the whole content moved to the second sheet and left the first with the head alone. */
    .cv-page__grid {
      display: block;
      padding: var(--fjord-space-6) 0 0;
    }
    .cv-page__main {
      display: block;
    }
    .cv-page__main > :global(section + section) {
      margin-top: var(--fjord-space-5);
    }
    /* A sheet is denser than a screen: the rows of the lists sit closer. */
    .cv-page__skills {
      gap: var(--fjord-space-3) var(--fjord-space-6);
    }
    .cv-page :global(.cv-job__list > li),
    .cv-page :global(.dated-rows > li) {
      padding-block: var(--fjord-space-2);
    }
    .cv-page :global(.fj-skills) {
      padding-top: var(--fjord-space-2);
    }
    .cv-page :global(.cv-job) {
      gap: var(--fjord-space-3);
    }
    .cv-page :global(.cv-head) {
      padding-top: 0;
      gap: var(--fjord-space-2);
    }
    .cv-page :global(.cv-section),
    .cv-page :global(.cv-section__body) {
      gap: var(--fjord-space-3);
    }
    .cv-page :global(a[href^='http']:not(.cv-print-line a, .cv-projects__item a))::after {
      content: ' (' attr(href) ')';
    }
    /* The sheet is the measure: the reading widths of the screen would leave a third of it empty. */
    .cv-page__main :global(*) {
      max-inline-size: none !important;
      max-width: none !important;
    }
    /* A heading keeps its number and stays with what follows; so does the label of a sub-list. */
    .cv-page__main :global(section[id] > :first-child) {
      break-inside: avoid;
      break-after: avoid;
    }
    .cv-page :global(.cv-job__eyebrow) {
      break-after: avoid;
    }
    /* A job is longer than a sheet can spare: kept whole it moved to the next sheet and left the
       one before half empty. Its head stays with what follows, and each of its parts stays whole. */
    .cv-page :global(.cv-job__head) {
      break-inside: avoid;
      break-after: avoid;
    }
    .cv-page :global(.cv-job__list > li),
    .cv-page :global(.cv-job__text > p),
    .cv-page :global(.cv-projects__item),
    .cv-page :global(.dated-rows > li) {
      break-inside: avoid;
    }
  }
</style>
