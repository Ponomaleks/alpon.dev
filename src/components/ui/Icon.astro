export type IconName = keyof typeof paths;

interface Props {
  name: IconName;
}

const { name } = Astro.props;
---

<svg
  viewBox="0 0 24 24"
  width="20"
  height="20"
  fill="none"
  stroke="currentColor"
  stroke-width="1.5"
  stroke-linecap="round"
  stroke-linejoin="round"
  aria-hidden="true"
  focusable="false"
>
  <path d={paths[name]}></path>
</svg>
