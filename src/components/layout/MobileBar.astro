---
import Button from '../ui/Button.astro';
import Icon from '../ui/Icon.astro';
import type { BarAction } from '../../data/shell-actions';

// Sticky action bar below 768 (AC-07, AC-08, AC-09). The live bar carries the hook H-2; `sample`
// leaves the hook off and positions the bar inside its frame for the Styleguide.
interface Props {
  actions: readonly [BarAction, BarAction];
  sample?: boolean;
  /** Sample only: draws the bar collapsed, to its tab. */
  collapsed?: boolean;
}

const { actions, sample = false, collapsed = false } = Astro.props;
---

<details
  class="mobile-bar"
  open={!(sample && collapsed)}
  data-shell-bar={sample ? undefined : ''}
  data-sample={sample ? '' : undefined}
>
  <summary class="mobile-bar__tab">
    <span class="mobile-bar__label">Quick actions</span>
    <span class="mobile-bar__chevron mobile-bar__chevron--down">
      <Icon name="chevron-down" />
    </span>
    <span class="mobile-bar__chevron mobile-bar__chevron--up">
      <Icon name="chevron-up" />
    </span>
  </summary>
  {actions.map((action) => (
    <Button
      href={action.href}
      variant="secondary"
      icon={action.icon}
      download={action.download}
      block
    >
      {action.label}
    </Button>
  ))}
</details>

<script>
  import { applyBarAction, decideBar } from '../../scripts/shell/action-bar';

  const bar = document.querySelector<HTMLElement>('[data-shell-bar]');
  if (bar) {
    const reduced = window.matchMedia('(prefers-reduced-motion: reduce)');
    let prev = window.scrollY;
    let queued = false;

    const update = () => {
      queued = false;
      const next = window.scrollY;
      applyBarAction(
        bar,
        decideBar({
          prev,
          next,
          // Keyboard focus only (G-4): a pointer tap on the tab leaves focus there but is not keyboard use.
          focusInside:
            bar.contains(document.activeElement) &&
            (document.activeElement?.matches(':focus-visible') ?? false),
          reducedMotion: reduced.matches,
        }),
      );
      // Keep the reference only after a decision that acted on it, so small steps add up.
      if (Math.abs(next - prev) >= 8 || next < 40) prev = next;
    };

    window.addEventListener(
      'scroll',
      () => {
        if (queued) return;
        queued = true;
        requestAnimationFrame(update);
      },
      { passive: true },
    );
  }
</script>

<style>
  .mobile-bar {
    position: fixed;
    inset-inline: 0;
    inset-block-end: env(safe-area-inset-bottom);
    z-index: var(--fjord-z-actionbar);
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: var(--fjord-space-2);
    padding: var(--fjord-space-3) var(--fjord-space-4);
    background-color: var(--fjord-color-bg-raised);
    border-block-start: var(--fjord-border-width) solid var(--fjord-color-border);
    box-shadow: var(--fjord-shadow-float);
  }

  /* Collapsed: only the tab stays, in the bottom end corner above the safe area. */
  .mobile-bar:not([open]) {
    padding: 0;
    background-color: transparent;
    border-block-start-width: 0;
    box-shadow: none;
  }

  .mobile-bar::details-content {
    grid-column: 1 / -1;
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: var(--fjord-space-2);
  }

  .mobile-bar__tab {
    position: absolute;
    inset-block-end: 100%;
    inset-inline-end: var(--fjord-space-4);
    display: grid;
    place-items: center;
    inline-size: var(--fjord-tap-min);
    block-size: var(--fjord-tap-min);
    color: var(--fjord-color-text);
    background-color: var(--fjord-color-bg-raised);
    border: var(--fjord-border-width) solid var(--fjord-color-border);
    border-radius: var(--fjord-radius-md) var(--fjord-radius-md) 0 0;
    cursor: pointer;
    list-style: none;
  }

  .mobile-bar:not([open]) > .mobile-bar__tab {
    border-radius: var(--fjord-radius-md);
    box-shadow: var(--fjord-shadow-float);
  }

  .mobile-bar__tab::-webkit-details-marker {
    display: none;
  }

  .mobile-bar__label {
    position: absolute;
    inline-size: 1px;
    block-size: 1px;
    overflow: hidden;
    clip-path: inset(50%);
    white-space: nowrap;
  }

  .mobile-bar__chevron {
    display: flex;
  }

  .mobile-bar[open] .mobile-bar__chevron--up,
  .mobile-bar:not([open]) .mobile-bar__chevron--down {
    display: none;
  }

  .mobile-bar[inert] > .mobile-bar__tab {
    opacity: 0;
  }

  .mobile-bar[data-sample] {
    position: absolute;
  }

  @media (prefers-reduced-motion: no-preference) {
    .mobile-bar {
      transition: transform var(--fjord-duration-320) var(--fjord-ease-out);
    }
  }

  .mobile-bar[inert] {
    transform: translateY(calc(100% + var(--fjord-space-2)));
  }

  @media (min-width: 768px) {
    .mobile-bar:not([data-sample]) {
      display: none;
    }
  }
</style>
