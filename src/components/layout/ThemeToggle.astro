---
// Theme switch: two buttons in a group (AC-10, AC-12). The selected segment is styled from
// `data-theme` on <html>, so it is right before any script runs. `sample` renders a fixed
// selection for the styleguide and never reacts (hook H-3).
interface Props {
  sample?: 'dag' | 'natt';
}

const { sample } = Astro.props;
const options = [
  { value: 'dag', label: 'Light' },
  { value: 'natt', label: 'Dark' },
] as const;
---

<div
  class="theme-toggle"
  role="group"
  aria-label="Theme"
  data-needs-script={sample ? undefined : ''}
  data-sample={sample ? '' : undefined}
  data-selected={sample}
>
  {options.map((option) => (
    <button
      type="button"
      class="theme-toggle__segment"
      data-theme-button
      data-theme-value={option.value}
      aria-pressed={sample ? sample === option.value : undefined}
    >
      {option.label}
    </button>
  ))}
</div>

<script>
  import { isTheme, switchTheme, syncPressed } from '../../scripts/shell/theme';

  // `localStorage` is read when a theme is saved, inside the saving try/catch: with storage
  // blocked, reading it throws, and that must not break the page on load (AC-11).
  const env = {
    document,
    matchMedia: (q: string) => window.matchMedia(q),
    get storage() {
      return localStorage;
    },
  };

  // Expose the theme already set on <html> as the pressed segment from load (AC-12).
  const current = document.documentElement.dataset.theme;
  if (isTheme(current)) syncPressed(current, document);

  for (const button of document.querySelectorAll<HTMLButtonElement>('[data-theme-button]')) {
    button.addEventListener('click', () => switchTheme(button.dataset.themeValue, button, env));
  }
</script>

<style>
  .theme-toggle {
    display: inline-flex;
    padding: var(--fjord-space-1);
    gap: var(--fjord-space-1);
    background-color: var(--fjord-color-bg-sunken);
    border: var(--fjord-border-width) solid var(--fjord-color-border);
    border-radius: var(--fjord-radius-md);
  }

  .theme-toggle__segment {
    min-block-size: calc(var(--fjord-space-10) + var(--fjord-space-1));
    min-inline-size: calc(var(--fjord-space-10) + var(--fjord-space-1));
    padding-inline: var(--fjord-space-4);
    font-family: inherit;
    font-size: var(--fjord-text-ui);
    font-weight: var(--fjord-weight-medium);
    color: var(--fjord-color-text-muted);
    background: transparent;
    border: 0;
    border-radius: var(--fjord-radius-sm);
    cursor: pointer;
  }

  /* On spruce the sunken tint lifts the track; lichen text there is 4.28:1, so use the full text color. */
  :global(.fjord-on-spruce) .theme-toggle__segment {
    color: var(--fjord-color-text);
  }

  .theme-toggle__segment:hover {
    color: var(--fjord-color-text);
  }

  /* Selected from the theme itself (live) or from data-selected (sample). */
  :global(:root[data-theme='dag']) .theme-toggle:not([data-sample]) [data-theme-value='dag'],
  :global(:root[data-theme='natt']) .theme-toggle:not([data-sample]) [data-theme-value='natt'],
  .theme-toggle[data-selected='dag'] [data-theme-value='dag'],
  .theme-toggle[data-selected='natt'] [data-theme-value='natt'] {
    color: var(--fjord-color-text);
    background-color: var(--fjord-color-bg-raised);
  }
</style>
