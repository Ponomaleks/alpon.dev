{
  "plugins": [
    "react",
    "import"
  ],
  "rules": {
    "react/forbid-elements": [
      "warn",
      {
        "forbid": []
      }
    ],
    "no-restricted-imports": [
      "warn",
      {
        "patterns": [
          {
            "group": [
              "components/actions/**",
              "components/brand/**",
              "components/casestudy/**",
              "components/content/**",
              "components/cv/**",
              "components/feedback/**",
              "components/navigation/**",
              "ui_kits/alpon-dev/**"
            ],
            "message": "Import design-system components from 'index.js', not component internals."
          }
        ]
      }
    ],
    "no-restricted-syntax": [
      "warn",
      {
        "selector": "Literal[value=/#[0-9a-fA-F]{3,8}\\b/]",
        "message": "Raw hex color — use a design-system color token via var()."
      },
      {
        "selector": "Literal[value=/\\b\\d+px\\b/]",
        "message": "Raw px value — use a design-system spacing token via var()."
      },
      {
        "selector": "Literal[value=/font-family\\s*:\\s*(?!['\\\"]?(?:Schibsted Grotesk|JetBrains Mono))/i]",
        "message": "Font not provided by the design system. Available: Schibsted Grotesk, JetBrains Mono."
      },
      {
        "selector": "JSXOpeningElement[name.name='ArchDiagram'] > JSXAttribute > JSXIdentifier[name!=/^(?:columns|label|className|key|ref|className|style|children)$/]",
        "message": "<ArchDiagram> doesn't accept that prop. Declared props: columns, label, className."
      },
      {
        "selector": "JSXOpeningElement[name.name='AvailabilityBadge'] > JSXAttribute > JSXIdentifier[name!=/^(?:status|label|detail|className|key|ref|className|style|children)$/]",
        "message": "<AvailabilityBadge> doesn't accept that prop. Declared props: status, label, detail, className."
      },
      {
        "selector": "JSXOpeningElement[name.name='AvailabilityBadge'] > JSXAttribute[name.name='status'] > Literal[value!=/^(?:open|talking|employed)$/]",
        "message": "<AvailabilityBadge> status must be one of 'open' | 'talking' | 'employed'."
      },
      {
        "selector": "JSXOpeningElement[name.name='Breadcrumbs'] > JSXAttribute > JSXIdentifier[name!=/^(?:items|className|key|ref|className|style|children)$/]",
        "message": "<Breadcrumbs> doesn't accept that prop. Declared props: items, className."
